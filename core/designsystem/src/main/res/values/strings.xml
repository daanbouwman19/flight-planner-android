<?xml version="1.0" encoding="utf-8"?>
<!--
    Strings owned by the design system.

    Only strings a shared component renders itself belong here. Anything a screen
    supplies (titles, messages, action labels) stays with the screen — a design
    system that owns its callers' copy stops being reusable.
-->
<resources>

    <!-- Button on the shared error state, retries the failed operation. -->
    <string name="ds_error_state_retry">Try again</string>

    <!--
        Spoken by TalkBack for an indeterminate loading indicator. This is the
        only signal a screen-reader user gets that the screen is busy rather than
        empty, so it must be translated like any visible string.
    -->
    <string name="ds_loading_indicator_description">Loading</string>

    <!-- The dismissal action on the shared confirmation dialog. -->
    <string name="ds_confirmation_dialog_cancel">Cancel</string>

    <!-- The confirm action on the shared date picker. -->
    <string name="ds_date_picker_confirm">OK</string>

    <!--
        Below the runway diagram, when one or more runway ends have no
        published heading and could not be drawn as a ray — real on grass
        strips. Says so rather than silently omitting them; they still
        appear in the textual runway list beside the diagram.
    -->
    <plurals name="ds_runway_diagram_excluded">
        <item quantity="one">%1$d runway end has no published heading and is not shown</item>
        <item quantity="other">%1$d runway ends have no published heading and are not shown</item>
    </plurals>

</resources>
