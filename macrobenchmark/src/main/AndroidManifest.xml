<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        The benchmark process drives another app through UiAutomator, so it needs
        to see packages other than its own. Without this the target is invisible
        to `MacrobenchmarkRule` and every run fails with a package-not-found that
        looks like a missing install.
    -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission"
        xmlns:tools="http://schemas.android.com/tools" />

</manifest>
