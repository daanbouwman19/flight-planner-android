# Normalise to LF in the repository. gradlew in particular must keep LF or it
# is not executable on Unix checkouts.
* text=auto eol=lf
*.bat text eol=crlf
gradlew text eol=lf

*.jar binary
*.png binary
*.jpg binary
*.webp binary
*.db binary
*.zip binary
*.filamat binary
# The prebuilt airport index is read back byte for byte at startup, so it must
# never be subject to the `text=auto` end-of-line heuristics above.
*.index binary

# Generated data assets: large, and a diff is never meaningful.
app/src/main/assets/databases/*.db binary
app/src/main/assets/databases/*.index binary
tools/airportdb/data/*.csv -diff

# The prebuilt world outline is read back byte for byte, exactly like the index.
*.outline binary
app/src/main/assets/maps/*.outline binary
