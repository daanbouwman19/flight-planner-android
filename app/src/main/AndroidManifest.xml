<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- METAR lookups and satellite tiles for the globe. Everything else works offline. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
        Predictive back is opt-in per application, not per API level, and without
        this flag the platform keeps serving the legacy KEYCODE_BACK path: no
        back-to-home preview, no cross-activity animation, and Compose's
        PredictiveBackHandler never receives progress, so a sheet or a detail pane
        can only snap shut instead of following the finger. The flag arrived in
        API 33 and minSdk is 35, so there is no fallback to keep and no version
        guard to write — it is simply on.
    -->
    <application
        android:name=".FlightPlannerApplication"
        android:allowBackup="true"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.FlightPlanner.Starting">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.FlightPlanner.Starting">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
