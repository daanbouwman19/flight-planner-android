<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- METAR lookups and satellite tiles for the globe. Everything else works offline. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
        Predictive back is opt-in per application, not per API level, and without
        this flag the platform keeps serving the legacy KEYCODE_BACK path: no
        back-to-home preview, no cross-activity animation, and Compose's
        PredictiveBackHandler never receives progress, so a sheet or a detail pane
        can only snap shut instead of following the finger. The flag arrived in
        API 33 and minSdk is 35, so there is no fallback to keep and no version
        guard to write — it is simply on.
    -->
    <!--
        Backup is on, with rules: the settings DataStore carries the AVWX API key
        and stays on the device. See res/xml/data_extraction_rules.xml for what
        is excluded and why.
    -->
    <application
        android:name=".FlightPlannerApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.FlightPlanner.Starting">

        <!--
            `singleTask`, because the app is now reachable from outside itself.
            A widget tap and a launcher shortcut both start this activity with
            NEW_TASK; with the default `standard` mode the system brings the
            existing task forward and stacks a *second* MainActivity on top of
            the first, each with its own NavHost. `singleTask` routes the intent
            to the running instance through `onNewIntent` instead, which is
            where `LaunchIntents.parse` reads it. There is one activity, so this
            changes nothing about ordinary launches.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.FlightPlanner.Starting">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!--
                The watch's front door. `:wear` builds a
                `flightplanner://route/EHAM/EGLL?...` link and asks the phone to
                open it through `RemoteActivityHelper`; the Wear companion app
                delivers it here as an ordinary VIEW Intent, which is why this
                needs BROWSABLE and why nothing Play-services-shaped appears in
                this module at all. `WatchRouteLink` in `:core:handoff` is the
                grammar both sides compile against, and `LaunchIntents.parse`
                is what reads it.

                Not `autoVerify`: this is a private scheme rather than an https
                App Link, so there is no domain to verify against and no
                assetlinks.json to host.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:host="route"
                    android:scheme="flightplanner" />
            </intent-filter>
            <!-- The static shortcut list. See res/xml/shortcuts.xml. -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!--
            The "Today's challenge" widget. Glance's receiver, plus one system
            broadcast of our own choosing: TIMEZONE_CHANGED is on the platform's
            exemption list for manifest receivers and moves local midnight, so
            the widget re-renders on it. The date itself changes on an alarm
            (MidnightRefresh), because DATE_CHANGED is not deliverable this way.
            Exported, as every widget provider must be for the launcher to reach it.
        -->
        <receiver
            android:name=".widget.ChallengeWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_challenge_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_challenge_info" />
        </receiver>

        <!--
            The "Aircraft of the day" widget: the same shape as the one above,
            for the same reasons, on its own MidnightRefresh alarm so that
            removing one widget does not disarm the other. A second provider
            rather than a configuration of the first, because the launcher's
            picker lists providers — one entry each is how a user chooses
            between them.
        -->
        <receiver
            android:name=".widget.AircraftWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_aircraft_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_aircraft_info" />
        </receiver>

        <!--
            WorkManager arrives transitively with Glance, and its manifest merges
            a start-up initializer into this provider. Left in place it would
            construct WorkManager before `Application.onCreate` on every launch,
            for a feature only the widget uses. Only that one entry is removed;
            the profile installer, EmojiCompat and process-lifecycle initializers
            that share the provider are untouched. `FlightPlannerApplication`
            implements `Configuration.Provider`, so WorkManager builds itself the
            first time Glance asks for it. Verify by grepping the merged manifest
            for `WorkManagerInitializer` — it must be absent.
        -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                tools:node="remove" />
        </provider>
    </application>

</manifest>
