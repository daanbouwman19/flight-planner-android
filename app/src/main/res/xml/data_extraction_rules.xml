<?xml version="1.0" encoding="utf-8"?>
<!--
    What leaves the device in a backup or a device-to-device transfer.

    The one exclusion is the settings DataStore. It holds the AVWX API key
    (`AppSettings.avwxApiKey`), which is a credential tied to one user's account
    and quota; a cloud backup is the one place the app would otherwise write it
    somewhere the user does not control. The theme, unit and provider choices
    that share the file are lost with it and take four taps to restore — the
    price of not splitting the store, which is not worth doing for four
    preferences. Keystore encryption of the key was considered and declined for
    the same reason: it is a weather API key, not a secret worth a key hierarchy.

    Everything else — the user database with the fleet and the logbook — is
    exactly what a backup is for. The airport database is regenerated from the
    APK's asset on first launch and is excluded so a restore does not carry a
    stale copy that the version sidecar would only replace anyway.

    minSdk is 35, so `android:fullBackupContent` (the pre-31 form) is not
    declared: no supported device would read it.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/settings.preferences_pb" />
        <exclude domain="database" path="airports.db" />
        <exclude domain="database" path="airports.db.version" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/settings.preferences_pb" />
        <exclude domain="database" path="airports.db" />
        <exclude domain="database" path="airports.db.version" />
    </device-transfer>
</data-extraction-rules>
