<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!--
      The activity theme only has to survive until Compose takes over, so it is
      deliberately minimal. Real theming lives in :core:designsystem.
    -->
    <style name="Theme.FlightPlanner" parent="android:Theme.Material.NoActionBar" />

    <style name="Theme.FlightPlanner.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <item name="postSplashScreenTheme">@style/Theme.FlightPlanner</item>
        <item name="android:windowSplashScreenBehavior" tools:targetApi="33">icon_preferred</item>
    </style>

</resources>
