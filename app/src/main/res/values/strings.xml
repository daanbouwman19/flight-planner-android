<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">Flight Planner</string>

    <!-- Navigation -->
    <string name="destination_plan">Plan</string>
    <string name="destination_logbook">Logbook</string>
    <string name="destination_fleet">Fleet</string>
    <string name="destination_airports">Airports</string>
    <string name="destination_stats">Stats</string>
    <string name="destination_settings">Settings</string>
    <string name="action_back">Back</string>

    <!-- Plan screen -->
    <string name="plan_empty_title">No routes yet</string>
    <string name="plan_empty_message">Generate a batch and the routes appear here.</string>

    <string name="plan_no_matches_title">Nothing in range</string>
    <string name="plan_no_matches_message">No route fits the current aircraft, departure and runway
        requirements. Try clearing the departure or choosing a longer-range aircraft.</string>

    <string name="plan_pick_aircraft_title">Which aircraft?</string>
    <string name="plan_pick_aircraft_message">Choose an airframe and every route will be planned for it.</string>
    <string name="plan_pick_aircraft_action">Choose aircraft</string>

    <string name="plan_error_title">Could not generate routes</string>
    <string name="plan_error_index">The airport database could not be loaded, so no route can be
        planned. Everything else in the app still works.</string>
    <string name="plan_error_fleet">Your fleet is empty. Add an aircraft, or restore the default
        fleet from Settings.</string>
    <string name="plan_error_unknown">Something went wrong while generating routes.</string>

    <!--
        "All", not "Any". "Any" is the *value* of an unset filter below
        ("DEPARTURE / Any"), and using the same word for a scope here left one word
        meaning two things one row apart.
    -->
    <string name="plan_mode_all">All</string>
    <string name="plan_mode_not_flown">Not flown</string>
    <!--
        Spoken by TalkBack in place of the label and its count. %1$d is how many
        airframes have never been flown. The count is drawn as well now — chips are
        sized to their own label, so it no longer has to fit a third of the window —
        but "Not flown · 116" reads as a heading with a number, and this is a
        sentence.
    -->
    <plurals name="plan_mode_not_flown_description">
        <item quantity="one">Not flown, %1$d aircraft</item>
        <item quantity="other">Not flown, %1$d aircraft</item>
    </plurals>
    <string name="plan_mode_this_aircraft">This aircraft</string>

    <!-- Field labels, drawn in letter-spaced caps. Uppercase in the resource, as with DIST and ETE. -->
    <string name="plan_filter_departure_label">DEPARTURE</string>
    <string name="plan_filter_aircraft_label">AIRCRAFT</string>
    <!-- The value of a filter that is not set. -->
    <string name="plan_filter_unset">Any</string>
    <!--
        What a chosen airframe costs every route in the list: its range and the
        runway it needs. %1$s is nautical miles and %2$s is feet, both already grouped —
        the app formats aviation figures in a fixed locale. Keep them %1$s and %2$s.
    -->
    <string name="plan_filter_envelope">%1$s NM · %2$s ft</string>

    <string name="plan_action_generate">Generate</string>
    <string name="plan_action_undo">Undo</string>
    <!-- Snackbar after a route is swiped into the logbook. %1$s and %2$s are ICAO codes. -->
    <string name="plan_flight_logged">Logged %1$s to %2$s</string>

    <string name="plan_swipe_mark_flown">Mark flown</string>
    <string name="plan_swipe_replace">Replace</string>

    <string name="plan_chip_distance">DIST</string>
    <string name="plan_chip_time">ETE</string>
    <!-- Runway length shown under an airport code. %1$s is the length in feet, already
         grouped: the app formats aviation figures in a fixed locale so they read as chart
         figures everywhere. Keep it %1$s — a %1$d here throws at runtime. -->
    <string name="plan_runway_value">RWY %1$s ft</string>
    <!-- %1$s is a distance in nautical miles, already grouped. Keep it %1$s. -->
    <string name="plan_value_nautical_miles">%1$s NM</string>
    <!-- %1$s is a runway length in feet, already grouped. Keep it %1$s. -->
    <string name="plan_value_feet">%1$s ft</string>

    <string name="plan_runway_short">Runway shorter than this aircraft needs</string>

    <!--
        Spoken for a whole route card, so a screen reader reads one sentence
        instead of stopping on eleven separate nodes. In order: aircraft,
        departure code, departure name, destination code, destination name,
        distance in nautical miles, hours, minutes.
    -->
    <string name="plan_route_content_description">%1$s, %2$s %3$s to %4$s %5$s, %6$,d nautical
        miles, %7$d hours %8$d minutes</string>

    <string name="plan_picker_departure_title">Departure airport</string>
    <string name="plan_picker_aircraft_title">Aircraft</string>
    <string name="plan_picker_departure_hint">Code, name or city</string>
    <string name="plan_picker_aircraft_hint">Type code, manufacturer or category</string>
    <string name="plan_picker_clear_query">Clear search</string>
    <string name="plan_picker_clear_departure">Any departure</string>
    <string name="plan_picker_clear_aircraft">Any aircraft</string>
    <string name="plan_picker_largest_airports">Largest airports</string>
    <string name="plan_picker_already_flown">Already flown</string>
    <!-- %1$s is a category such as "Jet"; %2$s is the range in nautical miles, already grouped. -->
    <string name="plan_picker_aircraft_detail">%1$s · %2$s NM range</string>
    <string name="plan_picker_no_results_title">No matches</string>
    <!-- %1$s is what the user typed. -->
    <string name="plan_picker_no_results_message">Nothing matches “%1$s”.</string>

    <!-- Placeholder screens. Replaced as each phase builds its screen. -->
    <string name="logbook_empty_title">No flights logged</string>
    <string name="logbook_empty_message">Flights you mark as flown will appear here, grouped by month.</string>

    <string name="fleet_empty_title">Fleet is not built yet</string>
    <string name="fleet_empty_message">Your aircraft are already loaded — the aircraft picker on Plan lists them. This screen, which will show their ranges and what you have flown, is still to come.</string>

    <string name="airports_empty_title">Airport search is not built yet</string>
    <string name="airports_empty_message">The airport database is loaded, and the departure picker on Plan already searches it by code, name or city. This screen will search it too.</string>

    <string name="stats_empty_title">Nothing to summarise</string>
    <string name="stats_empty_message">Distance flown, favourite airports and your busiest aircraft will appear here.</string>

    <string name="settings_appearance">APPEARANCE</string>
    <string name="settings_theme_system">Follow the system</string>
    <string name="settings_theme_system_detail">Light or dark, whichever the phone is set to.</string>
    <string name="settings_theme_light">Light</string>
    <string name="settings_theme_light_detail">Always light, whatever the system does.</string>
    <string name="settings_theme_dark">Dark</string>
    <string name="settings_theme_dark_detail">Always dark, whatever the system does.</string>
    <string name="settings_theme_cockpit">Cockpit</string>
    <string name="settings_theme_cockpit_detail">Near-black with amber accents, for flying at night.</string>
    <string name="settings_dynamic_colour">Colours from your wallpaper</string>
    <string name="settings_dynamic_colour_detail">Off uses the app’s own palette: avgas blue and runway amber.</string>
    <string name="settings_dynamic_colour_cockpit">Cockpit sets its own colours.</string>
    <string name="settings_empty_message">Units, weather provider and dataset information are still to come.</string>
    <string name="settings_self_check_action">Run on-device self-check</string>

    <!-- Route detail -->
    <string name="route_detail_title">%1$s → %2$s</string>
    <string name="route_detail_departure">DEPARTURE</string>
    <string name="route_detail_destination">DESTINATION</string>
    <string name="route_detail_loading_airport">Reading the airport…</string>
    <string name="route_detail_missing_airport">This airport is not in the dataset.</string>
</resources>
